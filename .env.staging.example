# Staging env template — 給「可信任測試者 sim 下單」用的獨立測試站。
# 用法：在 staging VM 上 `cp .env.staging.example .env` 後填空白值。
# (.env 已在 .gitignore，永遠不要 commit 真實值。)
#
# 與正式站的關鍵差異：
#   1. 這是「agent 多人 simtrade」模式（ORDER_CHANNEL=agent + ORDER_MODE=sim）。
#   2. 測試者的永豐 API_KEY/SECRET 存在「他們自己電腦的 OS keychain」，不進這台 server。
#      → 因此本檔【不需要】SHIOAJI_TRADE_* / SHIOAJI_CA_* 那組伺服器端下單憑證。
#   3. SESSION_SECRET / POSTGRES_PASSWORD 都要用「全新、與正式站不同」的值，兩站互相隔離。

# --- 資料庫與網域（部署共用，各站獨立一份）---
# Postgres 密碼；docker-compose 會把它插進 app 的 DB_URL。用全新值。
POSTGRES_PASSWORD=

# Caddy 對外網域（自動 TLS）。新 VM 會有自己的 static IP：
# sslip.io 形式 → quant.<IP-用連字號>.sslip.io，例如 34.80.12.34 → quant.34-80-12-34.sslip.io
DOMAIN=

# 帳戶系統：簽 session cookie 用。用【全新】的 `openssl rand -base64 32`，勿沿用正式站的值。
SESSION_SECRET=

# 歷史回補用（可留空，staging 通常不回補）。
FINMIND_TOKEN=

# --- App 行為（預設值，通常不用改）---
POLL_INTERVAL_SECONDS=5
SYMBOL=TXF
# taifex（輪詢）| shioaji（永豐 tick streaming，靜默時自動 fallback MIS）
SOURCE=taifex
QUOTE_RETENTION_DAYS=7
TV_SYMBOL=TAIFEX:TXF1!
PORT=8000

# --- 行情用 Shioaji（選用；SOURCE=shioaji 才需要）---
# 唯讀行情，全站共用一組即可（可沿用你正式站那組唯讀 key，或留空走 MIS）。
# 注意：這【不是】下單憑證，跟下面的 agent 下單完全無關。
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_STALE_SECONDS=20

# ============================================================
# 下單子系統：agent 多人 simtrade（這台 staging 的重點）
# ============================================================
# 通道＝agent：Shioaji I/O 交給每位測試者自己電腦上的 quanquant-agent；
# 這台 server 只做風控/冪等/配額決策，不持有任何測試者的下單憑證。
ORDER_CHANNEL=agent

# 模式鎖 sim（模擬單，不動真錢）。agent 通道目前【只支援 sim】，填 real 會被拒絕啟動下單。
ORDER_MODE=sim

# owner 白名單：逗號分隔的 user id，唯一允許下單/核准 agent 的帳號。
# 建帳號後用 `quanquant-user list` 查 id 再填回來，改完【必須重啟】才生效。
#   例：ORDER_OWNER_USER_IDS=1,2,3
ORDER_OWNER_USER_IDS=

# --- 風控上限（預設值如下，測試站可視需要放寬/收緊；不填則吃程式預設）---
# ORDER_SYMBOL_WHITELIST=TXF
# ORDER_MAX_QTY_PER_ORDER=5
# ORDER_MAX_QTY_PER_DAY=20
# ORDER_MAX_ORDERS_PER_DAY=20
# ORDER_KILL_SWITCH_INITIAL=false

# --- Agent 連線參數（預設值如下，通常不用改）---
# AGENT_TOKEN_TTL_DAYS=30          # 測試者在 orders 頁簽發的 agent token 有效天數
# AGENT_COMMAND_EXPIRY_SECONDS=120
# AGENT_HEALTH_LEASE_SECONDS=90    # 超過此秒數沒收到 agent 健康心跳 → 該測試者 slot 擋新單

# --- 營運告警（選用）：agent 進入/解除 fail-stop 會推 Telegram ---
# OPS_TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=

# ⚠️ 刻意【不要】設定以下這組——它們是「in-process 單機直連」模式的伺服器端下單憑證，
#    agent 多人模式用不到，設了反而混淆：
#    SHIOAJI_TRADE_API_KEY / SHIOAJI_TRADE_SECRET_KEY / SHIOAJI_CA_PATH /
#    SHIOAJI_CA_PASSWD / SHIOAJI_PERSON_ID
