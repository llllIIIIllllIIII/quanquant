# Price fetch interval in seconds (default: 5)
POLL_INTERVAL_SECONDS=5

# Futures symbol fetched from TAIFEX (default: TXF = 台指期大台)
SYMBOL=TXF

# Data source: taifex (default polling) | finmind | shioaji (永豐 tick streaming)
SOURCE=taifex

# --- Shioaji (永豐) streaming live source — only used when SOURCE=shioaji ---
# Sub-second tick push; TAIFEX MIS automatically takes over whenever the stream
# is silent (login pending / disconnect / market closed). Read-only market data
# needs only the API key + secret (no CA certificate — that's order-only).
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
# MIS fallback kicks in after the stream is silent this many seconds (default 20;
# open-hours = pure Shioaji, MIS is just the disconnect safety net)
SHIOAJI_STALE_SECONDS=20
# Streaming throttles (ignored under polling): raw Quote writes ≤2/s, SSE ≤4/s,
# alert eval ≤1/s. Candles always consume every tick.
# QUOTE_WRITE_MIN_INTERVAL=0.5
# SSE_MIN_INTERVAL=0.25
# ALERT_EVAL_MIN_INTERVAL=1.0

# FinMind API token — needed for daily-K history backfill (free, register at
# finmindtrade.com). Also used by the finmind live source if selected.
FINMIND_TOKEN=

# Raw 5s quotes are pruned after N days (candles are the canonical store; 0 = keep forever)
QUOTE_RETENTION_DAYS=7

# Alerts → Telegram. Create a bot via @BotFather for the token, then message the
# bot and get your chat_id. Leave blank for browser-only alerts (SSE toasts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web dashboard ---
# Database (SQLite by default; swap to Postgres later by changing this URL)
DB_URL=sqlite:///./quanquant.db
HOST=127.0.0.1
PORT=8000

# The dashboard chart is drawn from our OWN captured TAIFEX data (Lightweight
# Charts) — TradingView cannot embed Taiwan market data due to licensing.
# TV_SYMBOL is only used to build the "open full chart on TradingView" link.
#   TAIFEX:TXF1!  -> 台指期大台 (TAIEX Futures)
#   TAIFEX:MXF1!  -> 小台 (Mini-TAIEX Futures)
TV_SYMBOL=TAIFEX:TXF1!
