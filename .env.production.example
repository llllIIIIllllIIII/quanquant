# Production env template — copy to .env on the VM and fill in secrets.
# (.env is gitignored; never commit real values.)

# Postgres superuser password for the compose-internal database (also interpolated
# into the app's DB_URL by docker-compose.yml).
POSTGRES_PASSWORD=

# Public hostname Caddy serves (auto-TLS). sslip.io form: quant.<IP-with-dashes>.sslip.io
# e.g. static IP 34.80.12.34 -> quant.34-80-12-34.sslip.io
# Later swap to a real domain (e.g. quant.orgstar.tech): change this line only.
DOMAIN=

# FinMind token (history backfill; Sponsor tier unlocks tick-level minute backfill).
FINMIND_TOKEN=

# --- App behavior (defaults shown) ---
POLL_INTERVAL_SECONDS=5
SYMBOL=TXF
# taifex (polling) | shioaji (永豐 tick streaming, MIS auto-fallback)
SOURCE=taifex
QUOTE_RETENTION_DAYS=7
TV_SYMBOL=TAIFEX:TXF1!
PORT=8000

# --- Shioaji streaming (set SOURCE=shioaji to enable) ---
# Read-only market data → key + secret only, no CA cert. MIS takes over on silence.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_STALE_SECONDS=20

# --- Market Pulse v0.1 (price-velocity audio + Telegram) ---
# Audio + toggle are client-side; Telegram pushes on ENTERING Extreme. Needs
# SOURCE=shioaji for tick velocity, plus the Telegram bot below to push.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PULSE_ENABLED=true
# PULSE_TELEGRAM_LEVEL=4
# PULSE_TELEGRAM_COOLDOWN=60
